{
  "name": "dsh-gear-mode",
  "version": "0.1.3",
  "type": "module",
  "description": "行动档位：P/R/N/M/D/A 六档协作状态，宿主注入提示词 + 左侧档位滑轨 + set_gear 工具与手刹守卫",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "gear-mode",
    "autonomy",
    "agent-workflow"
  ],
  "license": "MIT",
  "author": "JanrilW",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Janrilw/dsh-gear-mode.git"
  },
  "bugs": {
    "url": "https://github.com/Janrilw/dsh-gear-mode/issues"
  },
  "homepage": "https://github.com/Janrilw/dsh-gear-mode#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "prompts.md",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout"]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
